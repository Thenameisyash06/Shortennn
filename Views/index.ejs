<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shortennn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --paper: #FAFAF7;
            --card: #FFFFFF;
            --ink: #1B2333;
            --ink-soft: #5B6472;
            --line: #E2E5EA;
            --accent: #E4572E;
            --accent-ink: #FFFFFF;
            --stub: #F3F1EA;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--paper);
            background-image:
                radial-gradient(circle at 1px 1px, #00000009 1px, transparent 0);
            background-size: 22px 22px;
            font-family: 'Inter', sans-serif;
            color: var(--ink);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 32px 20px 60px;
        }

        nav {
            width: 100%;
            max-width: 460px;
            display: flex;
            justify-content: flex-end;
            margin-bottom: 28px;
        }

        nav a { text-decoration: none; }

        nav button {
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.02em;
            color: var(--ink-soft);
            background: transparent;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 8px 14px;
            cursor: pointer;
            transition: border-color 0.15s ease, color 0.15s ease;
        }

        nav button:hover { border-color: var(--ink); color: var(--ink); }

        .eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--accent);
            margin: 0 0 6px;
        }

        h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 34px;
            font-weight: 700;
            letter-spacing: -0.01em;
            margin: 0 0 32px;
        }

        h1 span { color: var(--accent); }

        .stub {
            width: 100%;
            max-width: 460px;
            background: var(--stub);
            border: 1px dashed #C9B79A;
            border-radius: 10px;
            padding: 16px 18px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .stub p {
            margin: 0;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13.5px;
            color: var(--ink);
            word-break: break-all;
        }

        .stub .stub-label {
            display: block;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--ink-soft);
            margin-bottom: 4px;
        }

        .stub button {
            flex-shrink: 0;
            border: none;
            background: var(--ink);
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 600;
            padding: 8px 12px;
            border-radius: 7px;
            cursor: pointer;
        }

        .urlForm {
            width: 100%;
            max-width: 460px;
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 22px;
            box-shadow: 0 1px 2px rgba(27, 35, 51, 0.04), 0 8px 24px rgba(27, 35, 51, 0.05);
        }

        .urlForm label[for="url"] {
            display: block;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--ink-soft);
            margin-bottom: 8px;
        }

        input[type="url"] {
            width: 100%;
            font-family: 'JetBrains Mono', monospace;
            font-size: 14px;
            padding: 12px 14px;
            border: 1px solid var(--line);
            border-radius: 9px;
            background: var(--paper);
            color: var(--ink);
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        input[type="url"]:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(228, 87, 46, 0.12);
        }

        .action-row {
            display: flex;
            gap: 10px;
            margin-top: 14px;
        }

        button[type="submit"] {
            flex: 1;
            background: var(--accent);
            color: var(--accent-ink);
            border: none;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 15px;
            font-weight: 600;
            padding: 12px 16px;
            border-radius: 9px;
            cursor: pointer;
            transition: transform 0.12s ease, filter 0.12s ease;
        }

        button[type="submit"]:hover { filter: brightness(1.06); }
        button[type="submit"]:active { transform: translateY(1px); }

        .options {
            background: transparent;
            border: 1px solid var(--line);
            color: var(--ink-soft);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            font-weight: 600;
            padding: 12px 16px;
            border-radius: 9px;
            cursor: pointer;
            transition: border-color 0.15s ease, color 0.15s ease;
        }

        .options:hover { border-color: var(--ink); color: var(--ink); }

        .custom {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid var(--line);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px 16px;
        }

        .chip {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13.5px;
            color: var(--ink);
        }

        .chip input[type="checkbox"] {
            appearance: none;
            width: 17px;
            height: 17px;
            border: 1.5px solid var(--line);
            border-radius: 5px;
            display: grid;
            place-content: center;
            cursor: pointer;
            margin: 0;
        }

        .chip input[type="checkbox"]::before {
            content: "";
            width: 9px;
            height: 9px;
            border-radius: 2px;
            transform: scale(0);
            transition: transform 0.1s ease-in;
            background: var(--accent);
        }

        .chip input[type="checkbox"]:checked::before { transform: scale(1); }
        .chip input[type="checkbox"]:checked { border-color: var(--accent); }

        .length-field {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding-top: 4px;
        }

        .length-field label {
            font-size: 13.5px;
            color: var(--ink);
        }

        .length-field input[type="number"] {
            width: 76px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13.5px;
            padding: 7px 8px;
            border: 1px solid var(--line);
            border-radius: 7px;
            background: var(--paper);
            color: var(--ink);
            outline: none;
        }

        .length-field input[type="number"]:focus { border-color: var(--accent); }

        .toast {
            position: fixed;
            bottom: 28px;
            left: 50%;
            transform: translateX(-50%) translateY(12px);
            background: var(--ink);
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            padding: 10px 18px;
            border-radius: 999px;
            box-shadow: 0 8px 24px rgba(27, 35, 51, 0.18);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.18s ease, transform 0.18s ease;
        }

        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>
    <nav>
        <a href="/url/analytics"><button>Analytics →</button></a>
    </nav>

    <p class="eyebrow"> customizable link compressor</p>
    <h1>Short<span>ennn</span></h1>

    <% if (locals.id) { %>
    <div class="stub">
        <p><span class="stub-label">Generated URL</span><span id="short-link"><%= baseUrl %>/r/<%= id %></span></p>
        <button type="button" onclick="copyLink()">Copy</button>
    </div>
    <% } %>

    <div id="toast" class="toast">Copied to clipboard</div>

    <form action="/url" method="POST" class="urlForm">
        <label for="url">URL</label>
        <input type="url" id="url" name="url" placeholder="https://example.com/your-long-link" required>

        <div class="action-row">
            <button type="submit">Generate</button>
            <button type="button" onclick="toggle()" class="options">Options</button>
        </div>

        <div class="custom" id="option" style="display: none;">
            <label class="chip"><input type="checkbox" name="small" id="small" value="small letters">Small letters</label>
            <label class="chip"><input type="checkbox" name="captial" id="captial" value="captial letters">Capital letters</label>
            <label class="chip"><input type="checkbox" name="numbers" id="numbers" value="numbers">Numbers</label>
            <label class="chip"><input type="checkbox" name="symbols" id="symbols" value="symbols">Symbols</label>
            <div class="length-field">
                <label for="length">Specify length</label>
                <input type="number" name="length" id="length" min="4" max="50" placeholder="8">
            </div>
        </div>
    </form>

    <script>
        function toggle(){
            const box = document.getElementById("option");
            box.style.display = box.style.display === "none" ? "grid" : "none";
        }

        function copyLink(){
            const text = document.getElementById("short-link").innerText.trim();
            navigator.clipboard.writeText(text);
            showToast();
        }

        let toastTimer;
        function showToast(){
            const toast = document.getElementById("toast");
            toast.classList.add("show");
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove("show"), 1800);
        }
    </script>
</body>
</html>